{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchResult v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "status": {
      "enum": [
        "succeeded",
        "insufficient",
        "failed",
        "canceled"
      ]
    },
    "arguments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim_type": {
            "enum": [
              "fact",
              "inference",
              "assumption"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "maxItems": 40,
            "uniqueItems": true
          },
          "verification_status": {
            "type": "string",
            "enum": [
              "independent_verified",
              "reported_only"
            ]
          }
        },
        "required": [
          "claim_type",
          "text",
          "evidence_ids"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "claim_type": {
                  "enum": [
                    "fact",
                    "inference"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "evidence_ids": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      },
      "maxItems": 30
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_.:-]+$"
      },
      "maxItems": 40,
      "uniqueItems": true
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "maxItems": 30
    },
    "counterevidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim_type": {
            "enum": [
              "fact",
              "inference",
              "assumption"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "maxItems": 40,
            "uniqueItems": true
          },
          "verification_status": {
            "type": "string",
            "enum": [
              "independent_verified",
              "reported_only"
            ]
          }
        },
        "required": [
          "claim_type",
          "text",
          "evidence_ids"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "claim_type": {
                  "enum": [
                    "fact",
                    "inference"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "evidence_ids": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      },
      "maxItems": 30
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 112000
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16800
        },
        "usage_unknown": {
          "type": "boolean"
        },
        "simulated": {
          "type": "boolean"
        }
      },
      "required": [
        "model_calls",
        "tool_calls",
        "input_tokens",
        "output_tokens",
        "usage_unknown"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "message": {
            "type": "string",
            "maxLength": 500
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ]
      },
      "maxItems": 10
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "status",
    "arguments",
    "evidence_ids",
    "unknowns",
    "counterevidence",
    "usage",
    "errors"
  ]
}
