# Shared host
ZHIGU_POSTGRES_DSN=host=127.0.0.1 user=zhigu password=zhigu dbname=zhigu port=5432 sslmode=disable TimeZone=UTC
ZHIGU_HTTP_ADDR=:8080
ZHIGU_RESEARCH_URL=http://127.0.0.1:8091
ZHIGU_INTERNAL_TOKEN=replace-me
ZHIGU_JWT_SECRET=replace-with-a-distinct-random-secret

# Investment event intelligence (disabled by default)
ZHIGU_INTEL_ENABLED=false
VITE_INTEL_ENABLED=false
ZHIGU_INTEL_MODE=demo
ZHIGU_INTEL_PROVIDERS=
ZHIGU_INTEL_COOKIE_SECRET=replace-with-32-plus-random-bytes
ZHIGU_INTEL_PUBLIC_ORIGIN=http://localhost:5173
ZHIGU_INTEL_DAILY_TOKEN_LIMIT=200000
ZHIGU_INTEL_LIVE_TEST=0
ZHIGU_INTEL_MODEL_CONFIG_ID=
ZHIGU_INTEL_MODEL_CONFIG_DIGEST=
ZHIGU_INTEL_MODEL_PROTOCOL=
ZHIGU_INTEL_MODEL=

# Live provider secrets must remain server-side and are omitted here.
IFIND_MCP_URL=
IFIND_AUTHORIZATION=
FUYAO_API_KEY=
