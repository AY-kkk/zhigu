[Unit]
Description=Zhigu encrypted backup and maintenance checks
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=ZHIGU_ROOT=/opt/zhigu
EnvironmentFile=/etc/zhigu/maintenance.env
ExecStart=/usr/local/lib/zhigu/maintenance-run.sh
TimeoutStartSec=20min
User=zhigu
Group=zhigu
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/zhigu /run/zhigu /var/run/docker.sock
