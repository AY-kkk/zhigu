{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhigu.local/contracts/strategy-v1/strategy.schema.json",
  "title": "strategy.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "instrument_id", "signal_period", "price_basis", "indicators", "entry", "exit", "position", "risk", "execution"],
  "properties": {
    "schema_version": { "const": "strategy.v1" },
    "name": { "type": "string", "minLength": 1 },
    "instrument_id": { "type": "string", "minLength": 1 },
    "signal_period": { "const": "1d" },
    "price_basis": { "enum": ["raw", "causal_qfq"] },
    "indicators": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "params"],
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["MA", "EMA", "BOLL", "VOL", "MACD", "KDJ", "RSI", "WR", "BIAS", "CCI", "ATR", "OBV"] },
          "params": { "type": "object" }
        }
      }
    },
    "entry": { "type": "object" },
    "exit": { "type": "object" },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "equity_fraction" },
        "value": { "type": "string", "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$" }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check"],
      "properties": {
        "check": { "const": "close" },
        "stop_loss_pct": { "type": ["string", "null"] },
        "take_profit_pct": { "type": ["string", "null"] },
        "max_holding_bars": { "type": ["integer", "null"] }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timing", "priority"],
      "properties": {
        "timing": { "const": "next_session_open" },
        "priority": { "const": "exit_first" }
      }
    }
  }
}
