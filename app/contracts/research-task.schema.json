{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchTask v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "role": {
      "enum": [
        "supporter",
        "challenger"
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "horizon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "claim_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "claim_type": {
                "enum": [
                  "fact",
                  "inference",
                  "assumption"
                ]
              },
              "source_span_id": {
                "type": "string",
                "maxLength": 128
              }
            },
            "required": [
              "claim_id",
              "text",
              "claim_type"
            ]
          },
          "maxItems": 6,
          "minItems": 1
        }
      },
      "required": [
        "text",
        "horizon",
        "items"
      ]
    },
    "instrument_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "enum": [
        "fixture",
        "live"
      ]
    },
    "source_policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "model_config_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "max_model_calls": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "max_tool_calls": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "deadline_at": {
      "type": "string",
      "format": "date-time"
    },
    "document_id": {
      "type": "string",
      "maxLength": 128
    },
    "input_mode": {
      "type": "string",
      "enum": [
        "claim_only",
        "report_only",
        "claim_and_report"
      ]
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "role",
    "claim",
    "instrument_id",
    "as_of",
    "mode",
    "source_policy_version",
    "model_config_version",
    "prompt_version",
    "max_model_calls",
    "max_tool_calls",
    "deadline_at"
  ]
}
