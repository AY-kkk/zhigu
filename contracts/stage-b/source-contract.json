{
  "source_policy_version": "source_eastmoney_cninfo_v2",
  "data_version": "eastmoney_hsf10_hkf10_cninfo_v1",
  "connector_mode": "go_http",
  "user_agent": "Zhigu/0.1 (private research prototype; contact: local-dev@zhigu.invalid)",
