  "catalog": {
    "a_share": {
      "method": "GET",
      "url": "http://www.cninfo.com.cn/new/data/szse_stock.json",
      "fields": "stockList[].code,orgId,zwjc,pinyin,category",
      "exclude": "B股",
      "id_rule": "6xxxxx.SH / 0xxxxx.SZ / 3xxxxx.SZ / 4|8|92xxxx.BJ"
    },
    "hk": {
      "method": "GET",
      "url": "http://www.cninfo.com.cn/new/data/hke_stock.json",
      "fields": "stockList[].code,orgId,zwjc,pinyin",
      "id_rule": "00700.HK five-digit pad"
    }
  },
  "quality_sample": [
